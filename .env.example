# Copy to .env and fill in locally. Never commit credentials.
PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading control. Require explicit enable + valid limits to avoid accidental orders.
LIVE_TRADING_ENABLED=false
MAX_ORDER_IDR=0
MAX_PRICE_DEVIATION_PCT=0

# Indodax API V2: Private keys with order permission and withdrawal disabled.
# Paper trading uses only public ticker; no credential leak risk.
INDODAX_API_KEY=
INDODAX_API_SECRET=

# Paper BTC/IDR: entry % signal, outlook detection.
SIGNAL_THRESHOLD_PCT=1.0
ALERT_COOLDOWN_MINUTES=60

# Paper altcoin IDR pairs: monitor top N volume by quote, momentum entry threshold.
# Tune only after walk-forward validation; changes require explicit approval.
ALTCOIN_TOP_N=10
ALTCOIN_ENTRY_THRESHOLD_PCT=1.0

# Market polling: WSS fallback to REST /ticker each interval.
POLL_INTERVAL_SECONDS=30
