# Copy to .env and fill in locally. Never commit credentials.
PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# For monitoring only, no trade permission needed. Keep withdrawal disabled.
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Signals: minimum % change in recent observations; tune only after paper trading.
SIGNAL_THRESHOLD_PCT=1.0
ALERT_COOLDOWN_MINUTES=60
POLL_INTERVAL_SECONDS=30
